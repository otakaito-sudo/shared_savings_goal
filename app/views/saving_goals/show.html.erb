<% content_for :container_class, "container--wide" %>
<% badge = { "recruiting" => "open", "achieved" => "achieved",
             "canceled" => "closed", "expired" => "closed" }[@goal.display_status.to_s] %>

<div class="goal-hero">
  <!-- 1段目：左にタイトル・目的、右上に「目標金額を編集」ボタンを配置 -->
  <div class="goal-hero__header">
    <div>
      <h1>
        <%= @goal.name %>
        <span class="badge badge--<%= badge %>"><%= t("goals.status.#{@goal.display_status}", locale: :ja) %></span>
      </h1>
      <% if @goal.purpose.present? %>
        <p class="goal-hero__purpose"><%= @goal.purpose %></p>
      <% end %>
    </div>
    <% if @membership&.manager? && @goal.recruiting? %>
      <%= link_to "目標金額を編集", edit_saving_goal_target_amounts_path(@goal), class: "btn btn--muted goal-hero__edit-btn" %>
    <% end %>
  </div>

  <!-- 2段目：主役の「現在金額」と「達成率（93%）」、右側に目標・期限のサブ情報 -->
  <div class="goal-hero__stats">
    <div class="goal-hero__main-num">
      <span class="goal-hero__amount"><%= number_to_currency(@goal.current_amount, unit: "円", precision: 0) %></span>
      <span class="goal-hero__percent"><%= @goal.progress_percent %>%</span>
    </div>
    <p class="goal-hero__remaining">
      目標 <%= number_to_currency(@goal.target_amount, unit: "円", precision: 0) %>
      （残り <%= number_to_currency(@goal.remaining_amount, unit: "円", precision: 0) %>）
      ・ 期限 <%= @goal.deadline %>
      <% if @goal.days_remaining.negative? %>
        <span class="deadline-soon">（期限切れ）</span>
      <% elsif @goal.days_remaining <= 7 %>
        <span class="deadline-soon">（あと <%= @goal.days_remaining %> 日）</span>
      <% else %>
        （あと <%= @goal.days_remaining %> 日）
      <% end %>
    </p>
  </div>

  <% if @goal.achieved? %>
    <div class="achieved-banner">
      <%= image_tag "celebration.png", class: "achieved-banner__img", alt: "" %>
      <p>目標達成！みんなで貯めきりました！</p>
    </div>
  <% end %>

  <!-- 3段目：進捗バーとメンバー別内訳 -->
  <% colors = ["#EA580C", "#F59E0B", "#0E9F6E", "#3B82F6", "#EC4899", "#8B5CF6"] %>
  <div class="share-bar share-bar--hero">
    <% if @goal.target_amount.positive? %>
      <% @goal.memberships.includes(:user).each_with_index do |m, i| %>
        <% total = @member_totals[m.user_id] || 0 %>
        <% next if total.zero? %>
        <% seg_color = colors[i % colors.size] %>
        <div class="share-bar__seg"
             style="width: <%= [(total * 100.0 / @goal.target_amount).round(1), 100].min %>%; background: <%= seg_color %>; --seg-color: <%= seg_color %>;"
             data-tooltip="<%= m.user.name %>：<%= number_to_currency(total, unit: "円", precision: 0) %>"></div>
      <% end %>
    <% end %>
  </div>

  <ul class="share-legend">
    <% @goal.memberships.includes(:user).each_with_index do |m, i| %>
      <% total = @member_totals[m.user_id] || 0 %>
      <% next if total.zero? %>
      <li><span class="share-legend__dot" style="background: <%= colors[i % colors.size] %>"></span><%= m.user.name %> <%= number_to_currency(total, unit: "円", precision: 0) %></li>
    <% end %>
  </ul>
</div>

<% if @my_remanded_deposits.any? || @pending_deposit_count.positive? %>
  <div class="todo-box">
    <h2>あなたのやること</h2>
    <% @my_remanded_deposits.each do |d| %>
      <p>
        ⚠ <%= number_to_currency(d.request_amount, unit: "円", precision: 0) %> の入金が差し戻されています
        <% if d.review_comment.present? %>（理由：<%= d.review_comment %>）<% end %>
        。下の入金申請一覧から再申請してください。
      </p>
    <% end %>
    <% if @pending_deposit_count.positive? %>
      <p>確認待ちの入金が <%= @pending_deposit_count %> 件あります。下の入金申請一覧から確認してください。</p>
    <% end %>
  </div>
<% end %>

<!-- ヒーローと todo-box はすべてのタブで共通なのでそのまま -->

<!-- ================= 追加: タブの仕掛け ================= -->
<div class="app-tabs">
  <!-- ラジオボタン（非表示にして切り替えの判定に使う） -->
  <input type="radio" name="goal_tabs" id="tab-home" class="app-tabs__radio" checked>
  <input type="radio" name="goal_tabs" id="tab-members" class="app-tabs__radio">
  
  <!-- タブのメニューボタン -->
  <div class="app-tabs__nav">
    <label for="tab-home" class="app-tabs__label">入金</label>
    <label for="tab-members" class="app-tabs__label">メンバー・履歴</label>
  </div>

  <!-- タブの中身（パネル） -->
  <div class="app-tabs__panels">
    
    <!-- ================= パネル1: 入金・ホーム ================= -->
    <div class="app-tabs__panel" id="panel-home">
      
      <% if @chart_points.any? && @goal.target_amount.positive? %>
        <section class="chart-card">
          <h2>貯まり具合</h2>
          <div class="chart-wrapper">
            <div class="y-axis">
              <span class="y-axis__max"><%= number_to_currency(@goal.target_amount, unit: "円", precision: 0) %></span>
              <span class="y-axis__min">0円</span>
            </div>

            <div class="bars">
              <div class="target-line"></div>
              
              <!-- 追加：点と点を結ぶ折れ線（SVG） -->
              <% if @chart_points.size > 1 %>
                <%
                  # 各ドットの中心座標（X, Y）を計算して繋ぐ
                  line_points = @chart_points.each_with_index.map do |(date, total), i|
                    x = ((i + 0.5) / @chart_points.size) * 100.0
                    y = 100.0 - [(total * 100.0 / @goal.target_amount), 100.0].min
                    "#{x.round(2)},#{y.round(2)}"
                  end
                %>
                <svg class="chart-line-svg" viewBox="0 0 100 100" preserveAspectRatio="none">
                  <polyline points="<%= line_points.join(' ') %>" />
                </svg>
              <% end %>

              <% @chart_points.each do |date, total| %>
                <div class="bars__col">
                  <div class="bars__bar"
          style="bottom: <%= [(total * 100.0 / @goal.target_amount).round(1), 100].min %>%"
          data-tooltip="<%= date.strftime("%m/%d") %> 時点で <%= number_to_currency(total, unit: "円", precision: 0) %>"></div>
                  <span class="bars__label"><%= date.strftime("%m/%d") %></span>
                </div>
              <% end %>
            </div>
          </div>
          <p class="progress__label">目標 <%= number_to_currency(@goal.target_amount, unit: "円", precision: 0) %> に対する積み上がり</p>
        </section>
      <% end %>      
      <% if @goal.accepting_deposits? %>
        <section class="detail-col" id="deposit-form" style="margin-bottom: 24px;">
          <h2>入金を申請</h2>
          <%= form_with model: [@goal, @deposit] do |f| %>
              <p>
              <%= f.label :request_amount, "金額（円）" %>
              <%= f.number_field :request_amount, placeholder: "例：5000", min: 1 %>
              </p>
              <p>
              <%= f.submit "申請する", class: "btn btn--primary" %>
              </p>
          <% end %>

        </section>
      <% end %>

      <section class="detail-col detail-col--wide">
        <h2>入金申請一覧</h2>
        <% if @deposits.empty? %>
          <div class="empty-state">
            <%= image_tag "jar.png", class: "empty-state__img", alt: "" %>
            <p class="empty-state__title">まだ入金申請はありません</p>
            <p class="empty-state__text">最初の入金を申請して、貯金をスタートしましょう。</p>
          </div>
        <% end %>

        <turbo-frame id="deposits-page">
          <div class="deposits-list">
            <% @deposits.each do |d| %>
              <% dep_badge = { "pending" => "pending", "confirmed" => "approved",
                              "rejected" => "rejected", "remanded" => "returned" }[d.status] %>
              
              <div class="deposit-item">
                <!-- 上段：金額・ステータス・申請者と、操作ボタン -->
                <div class="deposit-item__main">
                  <div class="deposit-item__info">
                    <div class="deposit-item__header">
                      <span class="deposit-item__amount"><%= number_to_currency(d.request_amount, unit: "円", precision: 0) %></span>
                      <span class="badge badge--<%= dep_badge %>"><%= t("deposits.status.#{d.status}", locale: :ja) %></span>
                    </div>
                    <p class="deposit-item__meta">
                      <%= d.member.name %> さん
                      <% if d.reviewer %> ・ 確認者 <%= d.reviewer.name %> さん<% end %>
                      ・ <%= d.created_at.strftime("%m/%d") %>
                    </p>
                  </div>

                  <% if d.pending? && @membership&.manager? %>
                    <div class="deposit-item__actions">
                      <%= button_to "確認", confirm_deposit_path(d), method: :patch, class: "btn btn--primary btn--sm", data: { turbo_frame: "_top" } %>
                      <%= button_to "却下", reject_deposit_path(d), method: :patch, class: "btn btn--ghost-danger btn--sm", data: { turbo_frame: "_top" } %>
                      <label for="remand-toggle-<%= d.id %>" class="btn btn--muted btn--sm remand-trigger">
                        差し戻し
                      </label>
                    </div>
                  <% end %>
                </div>

                <!-- 差し戻し理由の表示（差し戻し済みの場合） -->
                <% if d.remanded? && d.review_comment.present? %>
                  <div class="deposit-item__notice">
                    <span class="deposit-item__notice-label">差し戻し理由</span>
                    <p><%= d.review_comment %></p>
                  </div>
                <% end %>

                <!-- 下段1：差し戻し入力ドロワー（チェックボックスで開閉） -->
                <% if d.pending? && @membership&.manager? %>
                  <input type="checkbox" id="remand-toggle-<%= d.id %>" class="remand-checkbox" hidden>
                  <div class="deposit-item__drawer">
                    <%= form_with url: remand_deposit_path(d), method: :patch, class: "remand-form", data: { turbo_frame: "_top" } do |f| %>
                      <%= f.text_field :review_comment, placeholder: "差し戻しの理由を入力（例：金額が間違っています）", required: true, class: "remand-form__input" %>
                      <div class="remand-form__btns">
                        <%= f.submit "差し戻しを確定", class: "btn btn--warning btn--sm" %>
                        <label for="remand-toggle-<%= d.id %>" class="btn btn--muted btn--sm">キャンセル</label>
                      </div>
                    <% end %>
                  </div>
                <% end %>

                <!-- 下段2：再申請フォーム（本人の差し戻し分） -->
                <% if d.remanded? && d.member == current_user %>
                  <div class="deposit-item__drawer deposit-item__drawer--open">
                    <%= form_with url: resubmit_deposit_path(d), method: :patch, class: "remand-form", data: { turbo_frame: "_top" } do |f| %>
                      <div class="resubmit-input-wrap">
                        <%= f.number_field :request_amount, value: d.request_amount, min: 1, class: "remand-form__input" %>
                        <span>円</span>
                      </div>
                      <%= f.submit "この金額で再申請", class: "btn btn--primary btn--sm" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <% if @deposit_pagy.pages > 1 %>
            <%== @deposit_pagy.series_nav %>
          <% end %>
        </turbo-frame>
      </section>

    </div>


    <!-- ================= パネル2: メンバー・履歴 ================= -->
    <div class="app-tabs__panel" id="panel-members">
      
      <div class="detail-grid">
        <section class="detail-col">
          <h2>参加メンバー</h2>
          <ul class="members-list">
              <% @goal.memberships.includes(:user).each do |m| %>
                  <li class="member-row">
                      <%= m.user.name %>
                      <% if m.manager? %>
                        <span class="badge badge--open">リーダー</span>
                      <% else %>
                        <span class="badge badge--pending">メンバー</span>
                      <% end %>
                        <span class="progress__label">
                          ・ 入金 <%= number_to_currency(@member_totals[m.user_id] || 0, unit: "円", precision: 0) %>
                          ／ 個人目標 <%= number_to_currency(m.target_amount, unit: "円", precision: 0) %>
                        </span>

                      <% if m.target_amount.positive? && (@member_totals[m.user_id] || 0) >= m.target_amount %>
                        <span class="achieved-badge-icon" data-tooltip="個人目標達成！">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1E9E5A" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -2px;"><path d="M4.5 12.5l5 5L19.5 7"/></svg>
                        </span>
                      <% end %>

                      <% if @membership&.manager? && m.user != current_user %>
                          <%= button_to "外す", saving_goal_membership_path(@goal, m),
                              method: :delete, form: {data: {turbo_confirm: "外しますか？"}}, class: "btn btn--muted" %>
                      <% end %>
                  </li>
              <% end %>
          </ul>
        </section>

          <% if @membership&.manager? %>
            <section class="detail-col">
              <h2>メンバーを招待する</h2>
              <% if @goal.open? %>
                <%= form_with url: saving_goal_invitations_path(@goal) do |f| %>
                  <%= f.email_field :email, placeholder: "招待する人のメールアドレス", required: true %>
                  <p class="role-picker__label">招待する役割</p>
                  <div class="role-picker">
                    <label class="role-option">
                      <%= f.radio_button :role, "member", checked: true, class: "role-option__input" %>
                      <span class="role-option__card">
                        <span class="role-option__title">メンバー</span>
                        <span class="role-option__desc">入金の申請ができます</span>
                      </span>
                    </label>
                    <label class="role-option">
                      <%= f.radio_button :role, "manager", class: "role-option__input" %>
                      <span class="role-option__card">
                        <span class="role-option__title">リーダー</span>
                        <span class="role-option__desc">入金の確認やメンバーの管理ができます</span>
                      </span>
                    </label>
                  </div>
                  <%= f.submit "招待メールを送る", class: "btn btn--primary" %>
                <% end %>
              <% else %>
                <p class="progress__label">募集を終了した目標には招待できません</p>
              <% end %>
              <% if @pending_invitations.present? %>
                <h3 style="margin-top: 32px; padding-top: 24px; border-top: 1px dashed #E5E7EB;">承諾待ちの招待</h3>
                  <ul>
                      <% @pending_invitations.each do |inv| %>
                          <li class="member-row">
                              <%= inv.email %> (期限：<%= inv.expires_at.to_date %>)
                              <%= button_to "取り消す", saving_goal_invitation_path(@goal, inv),
                                  method: :delete, form: {data: {turbo_confirm: "招待を取り消しますか？"}}, class: "btn btn--muted" %>
                          </li>
                      <% end %>
                  </ul>
              <% end %>
            </section>
          <% end %>
      </div>

      <section class="activity-card">
        <h2>活動履歴</h2>
        <% if @activities.any? %>
          <ul class="timeline">
            <% @activities.each do |a| %>
              <li class="timeline__item timeline__item--<%= a.kind %>">
                <span class="timeline__icon">
                  <%= image_tag "icons/activity-#{a.kind}.png", class: "timeline__img", alt: "" %>
                </span>

                <div class="timeline__body">
                  <p class="timeline__text"><%= activity_message(a) %></p>
                  <p class="timeline__time"><%= l a.created_at, format: :short rescue a.created_at.strftime("%m/%d %H:%M") %></p>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p>まだ活動はありません</p>
        <% end %>
      </section>
      <%= link_to "全ての活動をみる →", saving_goal_activities_path(@goal), class: "activity-more" %>
      
    </div>

  </div>
</div>
