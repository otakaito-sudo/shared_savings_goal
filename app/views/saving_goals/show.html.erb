<h1><%= @goal.name %></h1>
<p><%= @goal.purpose %></p>
<p>
    <%= number_to_currency(@goal.current_amount, unit: "円", precision: 0) %> / <%= number_to_currency(@goal.target_amount, unit: "円", precision: 0) %>
        (残り <%= number_to_currency(@goal.remaining_amount, unit: "円", precision: 0) %>)
</p>
<p>期限: <%= @goal.deadline %> / 状態: <%= t("goals.status.#{@goal.display_status}", locale: :ja) %></p>

<h2>参加メンバー</h2>
<ul>
    <% @goal.memberships.includes(:user).each do |m| %>
        <li>
            <%= m.user.name %> (<%= m.role %>) 
            <% if @membership&.manager? && m.user != current_user %>
                <%= button_to "外す", saving_goal_membership_path(@goal, m),
                    method: :delete, form: {data: {turbo_confirm: "外しますか？"}} %>
            <% end %>
        </li>
    <% end %>
</ul>

<% if @membership&.manager? && @goal.open? %>
  <%= form_with url: saving_goal_invitations_path(@goal) do |f| %>
    <%= f.email_field :email, placeholder: "招待する人のメールアドレス", required: true %>
    <%= f.submit "招待メールを送る" %>
  <% end %>
<% end %>

<% if @pending_invitations.present? %>
    <h3>承諾待ちの招待</h3>
    <ul>
        <% @pending_invitations.each do |inv| %>
            <li>
                <%= inv.email %> (期限：<%= inv.expires_at.to_date %>)
                <%= button_to "取り消す", saving_goal_invitation_path(@goal, inv),
                    method: :delete, form: {data: {turbo_confirm: "招待を取り消しますか？"}} %>
            </li>
        <% end %>
    </ul>
<% end %>

<% if @goal.accepting_deposits? %>
    <h2>入金を申請</h2>
    <%= form_with model: [@goal, @deposit] do |f| %>
        <%= f.number_field :request_amount %>
        <%= f.submit "申請する" %>
    <% end %>
<% end %>

<h2>入金申請一覧</h2>
<table>
    <tr><th>申請者</th><th>金額</th><th>状態</th><th>確認者</th><th>操作</th></tr>
    <% @deposits.each do |d| %>
        <tr>
            <td><%= d.member.name %></td>
            <td><%= number_to_currency(d.request_amount, unit: "円", precision: 0) %></td>
            <td>
                <%= t("deposits.status.#{d.status}", locale: :ja) %>
                <% if d.remanded? %><br><small><%= d.review_comment %></small><% end %>
            </td>
            <td><%= d.reviewer&.name %></td>
            <td>
                <% if d.pending? && @membership&.manager? %>
                    <%= button_to "確認", confirm_deposit_path(d), method: :patch %>
                    <%= button_to "却下", reject_deposit_path(d), method: :patch %>
                    <%= form_with url: remand_deposit_path(d), method: :patch do |f| %>
                        <%= f.text_field :review_comment, placeholder: "差し戻し理由" %>
                        <%= f.submit "差し戻し" %>
                    <% end %>
                <% end %>
                <% if d.remanded? && d.member == current_user %>
                    <%= form_with url: resubmit_deposit_path(d), method: :patch do |f| %>
                        <%= f.number_field :request_amount, value: d.request_amount %>
                        <%= f.submit "再申請" %>
                    <% end %>
                <% end %>
            </td>
        </tr>
    <% end %>
</table>
<%== @deposit_pagy.series_nav %>

<h2>活動履歴</h2>
<% if @activities.any? %>
  <ul class="activities">
    <% @activities.each do |a| %>
      <li>
        <%= l a.created_at, format: :short rescue a.created_at.strftime("%m/%d %H:%M") %>
        <%= activity_message(a) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだ活動はありません</p>
<% end %>
<%= link_to "全ての活動をみる", saving_goal_activities_path(@goal) %>