<% content_for :head do %>
  <style>
    body {
      background-color: #FFF9EE;
      background-image: url('<%= asset_path("login-bg.png") %>');
      background-size: cover;
      background-position: center bottom;
      background-repeat: no-repeat;
      background-attachment: fixed;
    }
  </style>
<% end %>

<div class="login-page-container">
  <div class="modern-auth-card">
    <h1 class="auth-title" style="margin-bottom: 12px;">パスワード再設定</h1>
    <p style="text-align: center; font-size: 0.85rem; color: #6B7280; line-height: 1.6; margin: 0 0 24px;">
      登録済みのメールアドレスを入力してください。<br>
      パスワード再設定用のリンクをお送りします。
    </p>

    <%= form_with url: password_resets_path, class: "auth-form" do |f| %>
      <div class="form-group" style="margin-bottom: 24px;">
        <%= f.email_field :email, placeholder: "メールアドレス", class: "modern-input", required: true %>
      </div>

      <%= f.submit "再設定メールを送る", class: "modern-btn" %>
    <% end %>

    <div class="auth-footer">
      <%= link_to "← ログイン画面に戻る", login_path, class: "register-link", style: "margin-left: 0;" %>
    </div>
  </div>
</div>