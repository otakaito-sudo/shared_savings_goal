<div class="auth-card">
    <h1>ログイン</h1>
    <%= form_with url: login_path do |f| %>
        <%= f.email_field :email, placeholder: "メールアドレス" %>
        <%= f.password_field :password, placeholder: "パスワード" %>

        <%= label_tag :remember_me do %>
            <%= check_box_tag :remember_me, "1" %>
            ログインしたままにする
        <% end %>

        <%= f.submit "ログイン", class: "btn btn--primary" %>
    <% end %>

    <%= link_to "パスワードを忘れた方", new_password_reset_url %>
    <p>アカウントをお持ちでない方 <%= link_to "ユーザー登録はこちら", new_user_path %></p>
</div>