<h1>プロフィール編集</h1>

<%= form_with model: @user do |f| %>
    <% if @user.errors.any? %>
        <ul class="flash-alert">
            <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
        </ul>
    <% end %>

    <div>
        <%= f.label :name, "名前" %>
        <%= f.text_field :name %>
    </div>

    <%= f.submit "更新する", class: "btn btn--primary" %>
<% end %>