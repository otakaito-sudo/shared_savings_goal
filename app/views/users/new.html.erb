<div class="auth-card">
    <p class="brand">共同貯金</p>
    <p class="brand-tagline">みんなで目標に向かって貯めるアプリ</p>
    <h1>ユーザー登録</h1>

    <%= form_with model: @user do |f| %>
        <% if @user.errors.any? %>
            <ul class="flash-alert">
                <% @user.errors.full_messages.each do |m| %>
                    <li><%= m %></li>
                <% end %>
            </ul>
        <% end %>

        <div>
            <%= f.label :name, "名前" %>
            <%= f.text_field :name %>
        </div>

        <div>
            <%= f.label :email, "メールアドレス" %>
            <%= f.email_field :email %>
        </div>

        <div>
            <%= f.label :password, "パスワード" %>
            <%= f.password_field :password %>
        </div>

        <%= f.submit "登録", class: "btn btn--primary" %>
    <% end %>

    <p><%= link_to "ログインはこちら", login_path %></p>
</div>